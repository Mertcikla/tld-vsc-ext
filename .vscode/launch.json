{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/extension.js"],
      "sourceMaps": true,
      "pauseForSourceMap": false,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**",
        "!${workspaceFolder}/out/webview/**"
      ],
      "preLaunchTask": "Build Extension Host"
    },
    {
      "name": "Run Extension (no debug)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "preLaunchTask": "Build Extension Host"
    }
  ]
}
